# Sample launcher for an installed softwake-ui binary.
# Copy to ~/.local/share/applications/ once softwake-ui is on PATH.
# Icon= is a theme name. Replace it with an icon you provide.
# Start softwaked serve before opening the window.
[Desktop Entry]
Type=Application
Version=1.0
Name=Softwake
Comment=Show Softwake state and send commands to the local daemon
Exec=softwake-ui
Icon=softwake
Terminal=false
Categories=Utility;
StartupNotify=false
