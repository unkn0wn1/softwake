# Optional fallbacks for provider API keys. Prefer the Settings screen.
# Each variable is read only when that provider is the active choice
# and Settings has no saved key. Never commit real keys.

# XAI_API_KEY=
# OPENAI_API_KEY=

# Publisher Email OAuth clients (maintainers / CI only).
# End users never paste these — Settings → Email is Connect / Disconnect only.
# Local: export in the shell that launches softwake-ui, or load via your wrapper.
# Do not invent placeholder ids. Missing id → Connect error.

# SOFTWAKE_GOOGLE_CLIENT_ID=
# SOFTWAKE_GOOGLE_CLIENT_SECRET=
# SOFTWAKE_MICROSOFT_CLIENT_ID=
