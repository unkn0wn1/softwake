{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Softwake",
  "version": "0.1.0",
  "identifier": "app.softwake.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Softwake",
        "width": 940,
        "height": 740,
        "minWidth": 800,
        "minHeight": 620,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "category": "Utility",
    "shortDescription": "Softwake local assistant",
    "longDescription": "Softwake settings window, system tray, and HUD. Release builds bundle softwaked beside the UI.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
