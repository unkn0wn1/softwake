{
  "identifier": "default",
  "description": "The main window may read daemon status, send voice-state commands, confirm tools, edit the soul pack, and use provider Settings.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-status",
    "allow-hibernate",
    "allow-resume",
    "allow-sleep",
    "allow-reload-soul",
    "allow-confirm-tool",
    "allow-cancel-tool",
    "allow-provider-snapshot",
    "allow-provider-select",
    "allow-provider-set-key",
    "allow-provider-set-base-url",
    "allow-provider-clear-cred",
    "allow-provider-oauth-start",
    "allow-provider-oauth-poll",
    "allow-provider-oauth-sign-out",
    "allow-provider-test",
    "allow-provider-set-model",
    "allow-provider-opt-in-plaintext",
    "allow-pack-snapshot",
    "allow-pack-save"
  ]
}
