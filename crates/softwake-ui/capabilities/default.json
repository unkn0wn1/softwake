{
  "identifier": "default",
  "description": "The Settings and HUD windows may read daemon status, send voice-state and ask commands, confirm tools, manage profiles and the soul pack, use provider Settings, and use email Settings.",
  "windows": [
    "main",
    "hud"
  ],
  "permissions": [
    "core:default",
    "allow-status",
    "allow-hibernate",
    "allow-resume",
    "allow-sleep",
    "allow-reload-soul",
    "allow-confirm-tool",
    "allow-cancel-tool",
    "allow-wake",
    "allow-ask",
    "allow-hud-snapshot",
    "allow-hud-ask",
    "allow-hud-set-layout",
    "allow-provider-snapshot",
    "allow-provider-select",
    "allow-provider-set-key",
    "allow-provider-set-base-url",
    "allow-provider-clear-cred",
    "allow-provider-oauth-start",
    "allow-provider-oauth-poll",
    "allow-provider-oauth-sign-out",
    "allow-provider-test",
    "allow-provider-set-model",
    "allow-provider-set-voice-model",
    "allow-provider-opt-in-plaintext",
    "allow-email-snapshot",
    "allow-email-save",
    "allow-email-clear-password",
    "allow-email-test",
    "allow-profiles-snapshot",
    "allow-profile-create",
    "allow-profile-rename",
    "allow-profile-set-active",
    "allow-pack-snapshot",
    "allow-pack-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://auth.x.ai"
        },
        {
          "url": "https://auth.x.ai/*"
        }
      ]
    }
  ]
}
